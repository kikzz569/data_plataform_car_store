                "spec": "{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"data\":{\"name\":\"databricks_query\"},\"width\":\"container\",\"height\":\"container\",\"transform\":[{\"aggregate\":[{\"op\":\"sum\",\"field\":\"valor_faturamento\",\"as\":\"receita_total\"},{\"op\":\"sum\",\"field\":\"margem_bruta_calculada\",\"as\":\"margem_bruta\"}],\"groupby\":[\"carro\"]},{\"fold\":[\"receita_total\",\"margem_bruta\"],\"as\":[\"metrica\",\"valor\"]},{\"calculate\":\"datum.metrica === 'receita_total' ? 'Receita' : 'Margem bruta'\",\"as\":\"serie\"}],\"mark\":{\"type\":\"bar\"},\"encoding\":{\"x\":{\"field\":\"valor\",\"type\":\"quantitative\",\"title\":null,\"axis\":{\"format\":\"~s\",\"grid\":false}},\"y\":{\"field\":\"carro\",\"type\":\"nominal\",\"title\":null,\"sort\":{\"field\":\"receita_total\",\"order\":\"descending\"}},\"yOffset\":{\"field\":\"serie\",\"sort\":[\"Receita\",\"Margem bruta\"]},\"color\":{\"field\":\"serie\",\"type\":\"nominal\",\"title\":null,\"scale\":{\"domain\":[\"Receita\",\"Margem bruta\"],\"range\":[\"#D8E2EA\",\"#6E8CA8\"]},\"legend\":{\"orient\":\"top\",\"title\":null}},\"tooltip\":[{\"field\":\"carro\",\"type\":\"nominal\",\"title\":\"Carro\"},{\"field\":\"serie\",\"type\":\"nominal\",\"title\":\"Métrica\"},{\"field\":\"valor\",\"type\":\"quantitative\",\"title\":\"Valor (R$)\",\"format\":\",.2f\"}]},\"config\":{\"autosize\":{\"type\":\"fit\",\"contains\":\"padding\"},\"axis\":{\"grid\":false}}}"
              },
