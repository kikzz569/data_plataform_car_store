{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas comerciais",
      "queryLines": [
        "SELECT\n",
        "  f.id_registro,\n",
        "  f.id_cliente_origem,\n",
        "  COALESCE(c.nome, CONCAT('ID em quarentena: ', f.id_cliente_origem)) AS cliente,\n",
        "  d.data AS data_entrega,\n",
        "  d.ano,\n",
        "  DATE_TRUNC('MONTH', d.data) AS mes_entrega,\n",
        "  p.nome_produto AS carro,\n",
        "  v.nome AS vendedor,\n",
        "  f.valor_faturamento,\n",
        "  f.margem_bruta_calculada\n",
        "FROM fato_vendas f\n",
        "JOIN dim_calendario d ON f.sk_data_entrega = d.sk_data\n",
        "JOIN dim_produto p ON f.sk_produto = p.sk_produto\n",
        "JOIN dim_vendedor v ON f.sk_vendedor = v.sk_vendedor\n",
        "LEFT JOIN dim_cliente c ON f.sk_cliente = c.sk_cliente\n"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Soma do valor de faturamento dos registros de venda no contexto selecionado.",
          "expression": "SUM(valor_faturamento)"
        },
        {
          "displayName": "Margem bruta",
          "description": "Soma do faturamento menos o custo informado no ERP; não desconta despesas operacionais.",
          "expression": "SUM(margem_bruta_calculada)"
        },
        {
          "displayName": "Registros de venda",
          "description": "Quantidade de registros de venda do ERP; a origem não fornece identificador de pedido.",
          "expression": "COUNT(id_registro)"
        },
        {
          "displayName": "Ticket médio por registro",
          "description": "Receita dividida pela quantidade de registros de venda.",
          "expression": "SUM(valor_faturamento) / COUNT(id_registro)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem bruta dividida pela receita no contexto selecionado.",
          "expression": "SUM(margem_bruta_calculada) / NULLIF(SUM(valor_faturamento), 0)"
        }
      ],
      "catalog": "lakehouse",
      "schema": "gold"
    },
    {
      "name": "ds_oportunidades",
      "displayName": "Oportunidades comerciais",
      "queryLines": [
        "SELECT\n",
        "  o.id_registro,\n",
        "  o.id_cliente_origem,\n",
        "  d.data AS data_interesse,\n",
        "  d.ano,\n",
        "  DATE_TRUNC('MONTH', d.data) AS mes_interesse,\n",
        "  p.nome_produto AS carro,\n",
        "  c.fonte AS canal,\n",
        "  o.etapa,\n",
        "  CASE o.etapa\n",
        "    WHEN 'Primeiro Contato' THEN 1\n",
        "    WHEN 'Agendamento' THEN 2\n",
        "    WHEN 'Negociação' THEN 3\n",
        "    WHEN 'Sucesso' THEN 4\n",
        "    WHEN 'Interesse Futuro' THEN 5\n",
        "    WHEN 'Insucesso' THEN 6\n",
        "    ELSE 99\n",
        "  END AS etapa_ordem\n",
        "FROM fato_oportunidade o\n",
        "JOIN dim_calendario d ON o.sk_data_interesse = d.sk_data\n",
        "JOIN dim_produto p ON o.sk_produto = p.sk_produto\n",
        "JOIN dim_canal c ON o.sk_canal = c.sk_canal\n"
      ],
      "columns": [
        {
          "displayName": "Clientes únicos",
          "description": "Clientes distintos observados nas oportunidades; não representa conversão entre etapas.",
          "expression": "COUNT(DISTINCT id_cliente_origem)"
        }
      ],
      "catalog": "lakehouse",
      "schema": "gold"
    }
  ],
